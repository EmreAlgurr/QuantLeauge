# RPC URL for Sepolia network (e.g., Alchemy, Infura, or public RPC)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployer wallet (DO NOT prefix with 0x)
PRIVATE_KEY=your_private_key_here

# Optional: Wallet address to set as the initial owner (the backend wallet).
# If left blank or commented out, the deployer wallet will be set as the initial owner.
BACKEND_OWNER_WALLET=0x0000000000000000000000000000000000000000
